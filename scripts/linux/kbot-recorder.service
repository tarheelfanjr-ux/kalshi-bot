# Prospective recorder as a systemd user service. Install: see docs/HOSTING.md.
[Unit]
Description=kbot prospective recorder (read-only)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/kalshi-bot
ExecStart=%h/kalshi-bot/.venv/bin/python -m kbot --log-level WARNING record
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
