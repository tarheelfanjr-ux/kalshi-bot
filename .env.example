# Copy to .env (never commit it) and `source .env` before running.
# Demo and production credentials are separate variables and are never interchangeable.
KBOT_MODE=paper
KBOT_DEMO_KEY_ID=
KBOT_DEMO_PRIVATE_KEY_PATH=~/.kalshi/demo_private_key.pem
# Production stays empty until every step in docs/LIVE_CHECKLIST.md is done.
KBOT_PROD_KEY_ID=
KBOT_PROD_PRIVATE_KEY_PATH=
KBOT_PRODUCTION_ENABLED=false
KBOT_PRODUCTION_ARM=
# Optional: a READ-ONLY production key so paper mode can use the WebSocket and CF Benchmarks index feed.
KBOT_PROD_READONLY_KEY_ID=
KBOT_PROD_READONLY_PRIVATE_KEY_PATH=
# Optional: a Pyth Pro API key (free trial from the Pyth Terminal) for `kbot collect-pyth`. Required since 2026-08-26.
PYTH_API_KEY=
# Required only if the dashboard binds to a non-local address.
KBOT_DASHBOARD_TOKEN=
